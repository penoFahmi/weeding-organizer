<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="INVOICE / BUKTI PESANAN"
        android:gravity="center"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:id="@+id/tvDetailKode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kode: ..."
        android:textSize="16sp"/>
    <TextView
        android:id="@+id/tvDetailNama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nama: ..."
        android:textSize="16sp"/>
    <TextView
        android:id="@+id/tvDetailPaket"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Paket: ..."
        android:textSize="16sp"/>
    <TextView android:id="@+id/tvDetailTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total: ..."
        android:textSize="16sp"
        android:textStyle="bold"/>
    <TextView android:id="@+id/tvDetailStatus"
        android:text="Status: ..."
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="#D81B60"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnMarkLunas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="UPDATE JADI LUNAS"
        android:backgroundTint="#4CAF50"/>

    <Button
        android:id="@+id/btnPrintPdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CETAK INVOICE (PDF)"
        android:backgroundTint="#2196F3"
        android:drawableStart="@drawable/ic_print"
        android:layout_marginTop="16dp"/>

</LinearLayout>